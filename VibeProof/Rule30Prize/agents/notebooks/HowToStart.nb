Notebook[{
Cell["How to Start on the Rule 30 Prize", "Title",
 CellID->874461601,ExpressionUUID->"22a1a762-10e3-861e-525e-3f4ca097ed64"],

Cell["The Rule 30 Prize kit \[Bullet] 2026", "Author",
 CellID->36768919,ExpressionUUID->"4da796ef-9f57-a4bf-7b5c-0fc91ae30e85"],

Cell["\<\
Rule 30 is one line of Boolean logic, yet its center column looks random, and \
nobody can prove anything about that randomness. This essay sets up the tools \
for the three Rule 30 Prize problems. It computes the pattern and its center \
column in the Wolfram Language. It loads the official Lean statements with \
LeanLink and checks that Lean's definition computes the same column. It \
proves a first, known result in the exact form the verifier reads, and it \
shows what the checks catch. It ends with how to write and submit an essay of \
your own.\
\>", "Abstract",
 CellID->1699946459,ExpressionUUID->"1b39f900-6440-cee7-4ac6-f16a0dfa94cd"],

Cell["The question", "Section",
 CellID->1535504786,ExpressionUUID->"75d93363-5da6-51a4-23e6-ab4d5453238e"],

Cell[TextData[{
 "Rule 30 updates every cell from itself and its two neighbors: the new color \
is ",
 StyleBox["left", "TI"],
 " XOR (",
 StyleBox["center", "TI"],
 " OR ",
 StyleBox["right", "TI"],
 "). Started from a single black cell, it grows a pattern that is regular on \
its left edge and looks random almost everywhere else."
}], "Text",
 CellID->1208482393,ExpressionUUID->"25a568a6-87a2-527f-535a-810032572145"],

Cell["The first 80 steps, with the center column in red:", "CodeText",
 CellID->28909615,ExpressionUUID->"00d7f70d-8d0e-ae34-30ec-ef5724b8f51e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pattern", " ", "=", " ", 
   RowBox[{"CellularAutomaton", "[", 
    RowBox[{"30", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "1", "}"}], ",", " ", "0"}], "}"}], ",", " ", "80"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"ArrayPlot", "[", 
  RowBox[{
   RowBox[{"ReplacePart", "[", 
    RowBox[{"pattern", ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"t_", ",", " ", "81"}], "}"}], " ", ":>", " ", 
      RowBox[{"2", " ", 
       RowBox[{"pattern", "[", 
        RowBox[{"[", 
         RowBox[{"t", ",", " ", "81"}], "]"}], "]"}]}]}]}], "]"}], ",", " ", 
   RowBox[{"ColorRules", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"0", " ", "->", " ", "White"}], ",", " ", 
      RowBox[{"1", " ", "->", " ", 
       RowBox[{"GrayLevel", "[", "0.15", "]"}]}], ",", " ", 
      RowBox[{"2", " ", "->", " ", "StandardRed"}]}], "}"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "520"}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",
 CellID->1443345818,ExpressionUUID->"2f3e8453-9762-68ea-56c5-1e1d22173a30"],

