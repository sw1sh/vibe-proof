     "[", "\"\<Type\>\"", "]"}], " ", "===", " ", 
    RowBox[{"LeanConst", "[", 
     RowBox[{"\"\<Ruliology.CellularAutomata.Rule30Prize.Problem1\>\"", ",", 
      " ", 
      RowBox[{"{", "}"}]}], "]"}]}], ",", " ", 
   RowBox[{
    RowBox[{"gap", "[", "\"\<Rule30Submission.problem1\>\"", "]"}], 
