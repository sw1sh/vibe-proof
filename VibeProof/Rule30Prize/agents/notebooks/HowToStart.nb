Cell[BoxData["\<\"\[ForAll] (k : Nat), 0 < k \[RightArrow] \[Exists] N, \
\[ForAll] (n : Nat), N \[LessEqual] n \[RightArrow] k * (2 * \
\[UpArrow](blackCount n) - \[UpArrow]n).natAbs \[LessEqual] n\"\>"], "Output",\

 CellLabel->"Out[8]= ",
 CellID->1680809496,ExpressionUUID->"65de4a87-3471-cd9f-13e6-63e1bd0597e5"]
}, Open  ]],

Cell[TextData[{
 "The Lean definition is meant to be checked, not run: it recomputes every \
cell from scratch, which takes about 3^t steps at time t. For a few cells it \
is fast enough to compare with ",
 Cell[BoxData["CellularAutomaton"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7bedd9bd-1d84-ddaa-2992-d0e79436a7f0"],
 "."
}], "Text",
 CellID->496109794,ExpressionUUID->"4c37f35a-e1a6-07fe-75cc-eb0790536dc4"],

Cell["\<\
The first 12 cells, computed by Lean, against the Wolfram Language's:\
\>", "CodeText",
 CellID->108435171,ExpressionUUID->"02f88238-86c8-66df-3287-2462337d4c25"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"LeanEvaluate", "[", 
   RowBox[{"\"\<(List.range 12).map \
Ruliology.CellularAutomata.Rule30Prize.center\>\"", ",", " ", 
    RowBox[{"\"\<ProjectDir\>\"", " ", "->", " ", "$Rule30PrizeKit"}], ",", 
    " ", 
    RowBox[{"\"\<Imports\>\"", " ", "->", " ", 
     RowBox[{"{", "\"\<Ruliology.CellularAutomata.Rule30Prize\>\"", "}"}]}]}],
    "]"}], " ", "===", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Take", "[", 
     RowBox[{"center", ",", " ", "12"}], "]"}], " ", "/.", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", " ", "->", " ", "True"}], ",", " ", 
      RowBox[{"0", " ", "->", " ", "False"}]}], "}"}]}], ")"}]}]], "Input",
 CellLabel->"In[9]:= ",
 CellID->525840340,ExpressionUUID->"034d641c-5834-e412-3173-7e4659c6cf78"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[9]= ",
 CellID->1708324045,ExpressionUUID->"52ce4f6a-032d-a48b-02f6-6734b6d90ed1"]
}, Open  ]],

Cell["A first result, in the submission format", "Section",
 CellID->203008389,ExpressionUUID->"5bfe104a-50de-a555-0985-8a1461680fbf"],

Cell[TextData[{
 "The verifier reads exactly one cell of a submitted notebook: ",
 Cell[BoxData[
  RowBox[{"rule30Submission", " ", "=", " ", 
   RowBox[{"LeanImportString", "[", 
    RowBox[{"\"\<...\>\"", ",", " ", "..."}], "]"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "134534fb-1061-d656-417a-ada5a115bcbc"],
 ". The verifier takes the literal Lean source from that cell, without \
evaluating anything, and rebuilds it in the kit. The same cell loads the \
source into this notebook as a ",
 Cell[BoxData["LeanEnvironment"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2cd98fd2-34e7-e188-54e6-269cbc93b3d2"],
 ", so the essay can examine its own proof."
}], "Text",
 CellID->1090263105,ExpressionUUID->"6e1c99a5-dcef-9c28-1623-100ed49be772"],

Cell["\<\
The cell with a known result, the case of period 1. The center column is \
never eventually constant, by Jen's theorem that no two columns of rule 30 \
are both eventually periodic:\
\>", "CodeText",
 CellID->1560876240,ExpressionUUID->"608e87cc-8fce-afdf-10b5-1e962a78f525"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rule30Submission", " ", "=", " ", 
  RowBox[{"LeanImportString", "[", 
   RowBox[{"\"\<import Rule30PrizeKit\n\nnamespace Rule30Submission\n\nopen \
Ruliology.CellularAutomata.Rule30Prize\n\n/-- The center column is not \
eventually constant: Problem 1 for period 1. -/\ntheorem no_period_one : \
\[Not] \[Exists] N, \[ForAll] t, N \[LessEqual] t \[RightArrow] center (t + \
1) = center t :=\n  center_not_eventually_period_one\n\nend Rule30Submission\n\
\>\"", ",", " ", 
    RowBox[{"\"\<ProjectDir\>\"", " ", "->", " ", "$Rule30PrizeKit"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[10]:= ",
 CellID->201914069,ExpressionUUID->"2aa912c6-4938-1bb7-5a56-8ba068cd699d"],

