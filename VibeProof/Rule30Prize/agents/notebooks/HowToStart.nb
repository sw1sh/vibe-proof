Cell["Suppose a claimed proof of Problem 1 has a gap.", "Text",
 CellID->1477609488,ExpressionUUID->"64c30c0d-1857-1b13-0cf0-a65799e26679"],

Cell[TextData[{
 "A theorem with the official type, proved by ",
 Cell[BoxData["sorry"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46632a09-cc5f-b0ef-6e10-cc52e5eb0235"],
 ":"
}], "CodeText",
 CellID->1030824397,ExpressionUUID->"6ea251ed-865f-e03c-1652-48b733ebb306"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gap", " ", "=", " ", 
   RowBox[{"LeanImportString", "[", 
    RowBox[{"\"\<import Rule30PrizeKit\nnamespace Rule30Submission\nopen \
Ruliology.CellularAutomata.Rule30Prize\ntheorem problem1 : Problem1 := by \
sorry\nend Rule30Submission\n\>\"", ",", " ", 
     RowBox[{"\"\<ProjectDir\>\"", " ", "->", " ", "$Rule30PrizeKit"}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[15]:= ",
 CellID->100031176,ExpressionUUID->"25a0bfbe-b1d4-2428-535f-36fbc0668f72"],

Cell["\<\
Its type is exactly the official statement, and its axioms give it away:\
\>", "CodeText",
 CellID->144223354,ExpressionUUID->"04786d0e-016a-d127-2c07-8568b01ca00d"],

Cell[CellGroupData[{

