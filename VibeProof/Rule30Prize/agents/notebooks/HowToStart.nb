Cell[TextData[{
 Cell[BoxData["Problem2"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c76c797-c249-79ca-540d-ded0f7fc4b10"],
 " says that for every k > 0, eventually k \[CenterDot] |2 \[CenterDot] \
(black cells among the first n) \[Minus] n| \[LessEqual] n: the black density \
is 1/2. Its definition:"
}], "CodeText",
 CellID->1657269721,ExpressionUUID->"35077f55-9291-6519-633d-771f27244c63"],

