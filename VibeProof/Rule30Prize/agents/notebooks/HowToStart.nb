}, Open  ]],

Cell[TextData[{
 "The verifier goes further than this axiom check. It rebuilds the source in \
a fresh sandbox and replays every declaration through the Lean kernel. That \
catches a theorem added without type checking, whose axiom list looks clean. \
The kit's ",
 Cell["tests/T05SkipKernel.lean", "InlineCode",ExpressionUUID->
  "14fd1512-f616-8834-3c82-8d5f83a0db1e"],
 " is such a forgery: its axiom list is empty, and the kernel rejects it."
}], "Text",
 CellID->311511756,ExpressionUUID->"66c67103-72a1-9427-0efe-696d0755ff0d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"forged", " ", "=", " ", 
   RowBox[{"LeanImportString", "[", 
    RowBox[{
     RowBox[{"Import", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
         "$Rule30PrizeKit", ",", " ", "\"\<tests\>\"", ",", 
          " ", "\"\<T05SkipKernel.lean\>\""}], "}"}], "]"}], ",", 
       " ", "\"\<Text\>\"", ",", " ", 
       RowBox[{"CharacterEncoding", " ", "->", " ", "\"\<UTF-8\>\""}]}], 
      "]"}], ",", " ", 
     RowBox[{"\"\<ProjectDir\>\"", " ", "->", " ", "$Rule30PrizeKit"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"forged", "[", "\"\<Rule30Submission.problem1\>\"", "]"}], 
    "[", "\"\<Axioms\>\"", "]"}], ",", " ", 
   RowBox[{
    RowBox[{"forged", "[", "\"\<Rule30Submission.problem1\>\"", "]"}], 
    "[", "\"\<KernelCheck\>\"", "]"}]}], "}"}]}], "Input",
 CellLabel->"In[17]:= ",
 CellID->1474733835,ExpressionUUID->"48c794f4-84f6-2bfc-78fc-0dbe2c8379c6"],

