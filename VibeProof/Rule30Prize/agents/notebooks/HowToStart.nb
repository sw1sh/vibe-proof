Cell["\<\
Problem 1 asks whether the column is eventually periodic. Here is a quick \
experiment, which proves nothing.\
\>", "Text",
 CellID->943101875,ExpressionUUID->"2867ea9b-6e8d-517b-581c-03c50b382041"],

Cell["\<\
Periods from 1 to 1000 that fit the second half of the first 100,001 cells:\
\>", "CodeText",
 CellID->67888809,ExpressionUUID->"76dfbc62-92ac-7b6e-1ee4-364c275949b4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Select", "[", 
  RowBox[{
   RowBox[{"Range", "[", "1000", "]"}], ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"center", "[", 
      RowBox[{"[", 
       RowBox[{"50001", " ", ";;", " ", 
        RowBox[{
         RowBox[{"-", "1"}], " ", "-", " ", "#"}]}], "]"}], "]"}], " ", "===",
      " ", 
     RowBox[{"center", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"50001", " ", "+", " ", "#"}], " ", ";;"}], "]"}], "]"}]}], 
    "&"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",
 CellID->1801257020,ExpressionUUID->"0df4b6a5-173c-e15a-3b8b-2f0fa2ceb3a0"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output",
 CellLabel->"Out[4]= ",
 CellID->358626973,ExpressionUUID->"4d620fc7-5cf2-d9d8-7b11-a6a15484ab22"]
}, Open  ]],

Cell["\<\
None does. A proof has to rule out every period, from every starting time.\
\>", "Text",
 CellID->876231958,ExpressionUUID->"741b091d-feb2-1a39-1c38-a146fb476903"],

Cell["The official statements in Lean", "Section",
 CellID->1020575516,ExpressionUUID->"3bf5a20e-c541-e06e-698a-446becf5b2b4"],

Cell[TextData[{
 "The Rule 30 Prize kit, ",
 ButtonBox["WolframInstitute/Rule30PrizeKit",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/WolframInstitute/Rule30PrizeKit"], None}],
 ", is a Lean 4 project. It holds the official statements, about 400 proved \
theorems of partial results, and 96 proved equivalent forms of Problem 1. The \
verifier checks every submission against exactly this project. ",
 ButtonBox["LeanLink",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://resources.wolframcloud.com/PacletRepository/resources/\
Wolfram/LeanLink/"], None}],
 " loads it into the Wolfram Language."
}], "Text",
 CellID->1967685850,ExpressionUUID->"07964fa7-8d1e-ff14-2dae-660124a8c27e"],

Cell[TextData[{
 "Load LeanLink, point it at the kit (set ",
 Cell[BoxData["RULE30PRIZE_KIT"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e367b18-9aa8-58f9-67ce-73421f5d2ac3"],
 ", or edit the fallback path), and check that the kit is there:"
}], "CodeText",
 CellID->1044562475,ExpressionUUID->"1dbaaaf7-1388-e538-4b59-43b1a622cc02"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Wolfram`LeanLink`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$Rule30PrizeKit", " ", "=", " ", 
   RowBox[{"Replace", "[", 
    RowBox[{
     RowBox[{"Environment", "[", "\"\<RULE30PRIZE_KIT\>\"", "]"}], ",", " ", 
     RowBox[{"$Failed", " ", "->", " ", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"$HomeDirectory", ",", " ", "\"\<Rule30PrizeKit\>\""}], "}"}],
        "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"DirectoryQ", "[", "$Rule30PrizeKit", "]"}]}], "Input",
 CellLabel->"In[5]:= ",
 CellID->1772362660,ExpressionUUID->"77d99fdb-a351-2d53-1de6-1684d6e477b9"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[5]= ",
 CellID->35498422,ExpressionUUID->"04646437-faee-7dfc-2c1c-7e70fe9b47c6"]
}, Open  ]],

Cell["\<\
The module that states the problems, keeping only its own constants:\
\>", "CodeText",
 CellID->1384978530,ExpressionUUID->"1cbde497-e826-5557-4442-fdd089d33fbd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"statements", " ", "=", " ", 
  RowBox[{"LeanImport", "[", 
   RowBox[{"\"\<Ruliology.CellularAutomata.Rule30Prize\>\"", ",", " ", 
    RowBox[{"\"\<ProjectDir\>\"", " ", "->", " ", "$Rule30PrizeKit"}], ",", 
    " ", 
    RowBox[{"\"\<Filter\>\"", " ", "->", " ", "\"\<Rule30Prize.\>\""}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[6]:= ",
 CellID->1407158826,ExpressionUUID->"6ecb37d0-fbcc-3e82-16c8-ae9dfe7e84e8"],

