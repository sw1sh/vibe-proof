R30ZBL.zrow_det : ∀ (L L' : Nat → Bool) (k t : Nat),
  (∀ (i : Nat), i < k → R30ZBL.zrow L (t + i) 1 = R30ZBL.zrow L' (t + i) 1) → R30ZBL.zrow L t k = R30ZBL.zrow L' t k
R30ZBL.zrow_pivot : ∀ (L L' : Nat → Bool) (k t : Nat),
  (∀ (i : Nat), i < k → R30ZBL.zrow L (t + i) 1 = R30ZBL.zrow L' (t + i) 1) →
    (R30ZBL.zrow L t (k + 1) ^^ R30ZBL.zrow L' t (k + 1)) = (R30ZBL.zrow L (t + k) 1 ^^ R30ZBL.zrow L' (t + k) 1)
R30ZBL.trace_surj : ∀ (y : Nat → Bool), ∃ L, ∀ (t : Nat), R30ZBL.zrow L t 1 = y t
R30ZBL.Q01_iff_Phi : R30ZBL.Q01 ↔ ∀ (f : Nat → Bool), ¬R30ZBL.FinSupp (R30ZBL.Phi f)
def R30ZBL.Q01 : Prop :=
∀ (L : Nat → Bool), R30ZBL.FinSupp L → ¬R30ZBL.InX L
def R30ZBL.InX : (Nat → Bool) → Prop :=
fun L => ∀ (s : Nat), R30ZBL.zrow L (2 * s) 1 = true
def R30ZBL.FinSupp : (Nat → Bool) → Prop :=
fun L => ∃ W, ∀ (k : Nat), W < k → L k = false
def R30ZBL.Phi : (Nat → Bool) → Nat → Bool :=
fun f k => R30ZBL.recon (fun t => if t % 2 = 0 then true else f (t / 2)) k 0
