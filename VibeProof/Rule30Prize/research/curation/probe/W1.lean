import Ruliology.CellularAutomata.Rule30StripCertificates

/-!
# Rule 30: the word `0^9 1 0 1` is excluded by a rank certificate

* `not_eventually_000000000101`: the center column is not eventually equal to `000000000101`
  repeated, whatever the transient and the phase.

The proof is a rank certificate (`Rule30StripCertificates.Cert`) for strip width `7` with
`1309` ranks; the kernel evaluates `Cert.check` and `Cert.checkG` on it, and
`Rule30StripCertificates.Cert.not_eventuallyWord` turns the checks into the exclusion. This
word is not in the bitmask table of `Rule30StripCertificateTable`. The kernel check takes about
30 seconds, so it has a module of its own.

Source: the Rule 30 Prize project (2026); the certificate was found by its trap search,
exported by a script, and is checked here by the kernel.
-/

namespace Ruliology.CellularAutomata
namespace Rule30StripCertificateWords

open Rule30Jen Rule30StripCertificates

-- certificate for w = 000000000101, strip width b = 7; generated by export_cert.py
def c000000000101_w : List Bool := [false, false, false, false, false, false, false, false, false, true, false, true]
def c000000000101_b : Nat := 7
def c000000000101_nranks : Nat := 1309
def c000000000101_rankP : Nat := 
def c000000000101_posP : Nat := 
def c000000000101_perP : Nat := 
def c000000000101_wordP : Nat := 

def C_c000000000101 : Cert :=
  { w := c000000000101_w, b := c000000000101_b, nranks := c000000000101_nranks,
    rankP := c000000000101_rankP, posP := c000000000101_posP, perP := c000000000101_perP,
    wordP := c000000000101_wordP }

set_option profiler true in
theorem X1 : C_c000000000101.check = true := by decide +kernel
end Rule30StripCertificateWords
end Ruliology.CellularAutomata
