AbsorbRight.no_black_white_run : ∀ (T P s r t1 : Nat),
  (∀ (t : Nat),
      T ≤ t → Ruliology.CellularAutomata.Rule30Prize.center (t + P) = Ruliology.CellularAutomata.Rule30Prize.center t) →
    T ≤ t1 →
      9 ≤ s →
        s + r ≤ P →
          (∀ (i : Nat), i < s → Ruliology.CellularAutomata.Rule30Prize.center (t1 + i) = true) →
            (∀ (i : Nat), i < r → Ruliology.CellularAutomata.Rule30Prize.center (t1 + s + i) = false) →
              1 + 9 * ((P - s - r + 9) / 2) ≤ r → False
'AbsorbRight.no_black_white_run' depends on axioms: [propext, Quot.sound]
'AbsorbRight.nine_black' depends on axioms: [propext, Quot.sound]
'AbsorbRight.black_shield' depends on axioms: [propext, Quot.sound]
'Ruliology.CellularAutomata.Rule30Jen.not_adjacent' depends on axioms: [propext, Quot.sound]
def Ruliology.CellularAutomata.Rule30Jen.cell : Nat → Int → Bool :=
fun x x_1 => Nat.brecOn (motive := fun x => Int → Bool) x Ruliology.CellularAutomata.Rule30Jen.cell._f x_1
def Ruliology.CellularAutomata.Rule30Jen.rule : Bool → Bool → Bool → Bool :=
fun a b c => a ^^ (b || c)
def Ruliology.CellularAutomata.Rule30Prize.center : Nat → Bool :=
fun t => Ruliology.CellularAutomata.Rule30Jen.cell t 0
def Ruliology.CellularAutomata.Rule30Jen.EventuallyPeriodic : (Nat → Bool) → Prop :=
fun f => ∃ T P, 0 < P ∧ ∀ (t : Nat), T ≤ t → f (t + P) = f t
