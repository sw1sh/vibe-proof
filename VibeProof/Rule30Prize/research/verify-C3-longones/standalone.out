[false, true, true, false]
R30SmallPeriods.no_period_long_ones : ∀ (T P : Nat),
  0 < P →
    (∀ (t : Nat),
        T ≤ t →
          Ruliology.CellularAutomata.Rule30Prize.center (t + P) = Ruliology.CellularAutomata.Rule30Prize.center t) →
      (∀ (t : Nat),
          T + 9 ≤ t →
            Ruliology.CellularAutomata.Rule30Prize.center t = false →
              Ruliology.CellularAutomata.Rule30Prize.center (t - 1) = true →
                ∀ (i : Nat), i < 9 → Ruliology.CellularAutomata.Rule30Prize.center (t - 1 - i) = true) →
        False
