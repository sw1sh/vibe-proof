'KC.EtherTrap.word_lemma' depends on axioms: [propext, Classical.choice, Quot.sound]
KC.EtherTrap.word_lemma : ∀ (w : List Bool) (T : Nat × List Bool → Prop),
  KC.EtherTrap.Closed w T →
    ∀ (x0 y : Nat × List Bool),
      T x0 →
        x0.fst < 4 →
          ∀ (P : List Bool) (a b : Nat → Bool) (L j0 : Nat),
            KC.EtherTrap.traj w x0 (fun n => P.getD n false) P.length = y →
              KC.EtherTrap.traj w y a L = y →
                KC.EtherTrap.traj w y b L = y →
                  L % 4 = 0 →
                    0 < L →
                      j0 < L →
                        KC.EtherTrap.white w (KC.EtherTrap.traj w y a j0) = true →
                          KC.EtherTrap.col1 (KC.EtherTrap.traj w y a j0) ≠
                              KC.EtherTrap.col1 (KC.EtherTrap.traj w y b j0) →
                            ∃ u,
                              (∀ (n : Nat), T (KC.EtherTrap.traj w x0 u n)) ∧
                                ¬KC.EtherTrap.MaskedPer w (KC.EtherTrap.traj w x0 u)
'KC.EtherTrap.node_traj' depends on axioms: [propext, Quot.sound]
KC.EtherTrap.node_traj : ∀ (w : List Bool) (x : Nat → Bool) (b t : Nat),
  Ruliology.CellularAutomata.Rule30Ether.node w x t b =
    KC.EtherTrap.traj w (Ruliology.CellularAutomata.Rule30Ether.node w x 0 b)
      (fun t =>
        Ruliology.CellularAutomata.Rule30Ether.drv (Ruliology.CellularAutomata.Rule30Ether.wordAt w) x t (b + 1))
      t
'KC.EtherTrap.escapes_of_certOK' depends on axioms: [propext, Classical.choice, Quot.sound]
KC.EtherTrap.escapes_of_certOK : ∀ (w : List Bool) (x0 : Nat × List Bool) (P A B : List Bool) (j0 : Nat),
  KC.EtherTrap.certOK w x0 P A B j0 = true →
    ∀ (T : Nat × List Bool → Prop),
      KC.EtherTrap.Closed w T →
        T x0 → ∃ u, (∀ (n : Nat), T (KC.EtherTrap.traj w x0 u n)) ∧ ¬KC.EtherTrap.MaskedPer w (KC.EtherTrap.traj w x0 u)
'KC.EtherTrap.escapes_take' depends on axioms: [propext, Quot.sound]
KC.EtherTrap.escapes_take : ∀ (w : List Bool) (b : Nat),
  1 ≤ b →
    ∀ (x0 : Nat × List Bool),
      b < x0.snd.length →
        ∀ (u : Nat → Bool),
          ¬KC.EtherTrap.MaskedPer w (KC.EtherTrap.traj w x0 u) →
            ∀ (T : Nat × List Bool → Prop),
              KC.EtherTrap.Closed w T →
                T (x0.fst, List.take b x0.snd) →
                  ∃ u',
                    (∀ (n : Nat), T (KC.EtherTrap.traj w (x0.fst, List.take b x0.snd) u' n)) ∧
                      ¬KC.EtherTrap.MaskedPer w (KC.EtherTrap.traj w (x0.fst, List.take b x0.snd) u')
'KC.EtherTrap.stepW_take' depends on axioms: [propext, Quot.sound]
KC.EtherTrap.stepW_take : ∀ (w : List Bool) (st : Nat × List Bool) (x : Bool) (b : Nat),
  b < st.snd.length →
    ((KC.EtherTrap.stepW w st x).fst, List.take b (KC.EtherTrap.stepW w st x).snd) =
      KC.EtherTrap.stepW w (st.fst, List.take b st.snd) (st.snd.getD b false)
