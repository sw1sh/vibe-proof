KC.PeriodTwoLang.no_pattern : ∀ (C : Ruliology.CellularAutomata.Rule30StripCertificates.Cert) (bad : Nat),
  C.w = [false, true] →
    ∀ (T T' : Nat),
      T ≤ T' →
        (∀ (t : Nat), T ≤ t → Ruliology.CellularAutomata.Rule30Jen.cell t 0 = C.wAt ((t - T) % C.P)) →
          (∀ (t : Nat),
              T' ≤ t → C.rk ((t - T) % C.P) (Ruliology.CellularAutomata.Rule30StripCertificates.rowR t C.b) = bad) →
            0 < C.b →
              ∀ (pat : List Bool),
                KC.PeriodTwoLang.occurs C bad pat = false →
                  ∀ (t : Nat),
                    T' ≤ t →
                      (t - T) % 2 = 0 →
                        ¬∀ (i : Nat),
                            i < pat.length → Ruliology.CellularAutomata.Rule30Jen.cell (t + 2 * i) 1 = pat.getD i false
