'KC.PeriodTwoW5.free_bit_constraints' depends on axioms: [propext, Classical.choice, Quot.sound]
KC.PeriodTwoW5.free_bit_constraints : ∀ (T : Nat),
  (∀ (t : Nat), T ≤ t → Ruliology.CellularAutomata.Rule30Jen.cell t 0 = ((t - T) % 2 == 1)) →
    ∃ T',
      T ≤ T' ∧
        ∀ (t : Nat),
          T' ≤ t →
            (t - T) % 2 = 0 →
              ∀ (pat : List Bool),
                pat ∈ KC.PeriodTwoW5.col1Forbidden →
                  ¬∀ (i : Nat),
                      i < pat.length → Ruliology.CellularAutomata.Rule30Jen.cell (t + 2 * i) (-1) = !pat.getD i false
'KC.PeriodTwoW5.col1_constraints' depends on axioms: [propext, Classical.choice, Quot.sound]
KC.PeriodTwoW5.col1_constraints : ∀ (T : Nat),
  (∀ (t : Nat), T ≤ t → Ruliology.CellularAutomata.Rule30Jen.cell t 0 = ((t - T) % 2 == 1)) →
    ∃ T',
      T ≤ T' ∧
        ∀ (t : Nat),
          T' ≤ t →
            (t - T) % 2 = 0 →
              ∀ (pat : List Bool),
                pat ∈ KC.PeriodTwoW5.col1Forbidden →
                  ¬∀ (i : Nat),
                      i < pat.length → Ruliology.CellularAutomata.Rule30Jen.cell (t + 2 * i) 1 = pat.getD i false
