'KC.StripeFront.stripe_prefix_family_list' depends on axioms: [propext, Classical.choice, Quot.sound]
KC.StripeFront.stripe_prefix_family_list : ∀ (m : Nat) (v : List Bool),
  v.length ≤ 3 →
    ∃ d,
      1 ≤ d ∧
        d ≤ m + 5 ∧
          (∀ (k : Nat),
              1 ≤ k → k < d → KC.StripeFront.rowV m v k = Ruliology.CellularAutomata.Rule30ZeroBoundary.stripe k) ∧
            KC.StripeFront.rowV m v d ≠ Ruliology.CellularAutomata.Rule30ZeroBoundary.stripe d ∧
              ∃ t,
                t ≤ d - 1 + 31 ∧
                  t % 2 = 0 ∧ Ruliology.CellularAutomata.Rule30ZeroBoundary.zrow (KC.StripeFront.rowV m v) t 1 = false
'KC.StripeFront.stripe_prefix_family' depends on axioms: [propext, Classical.choice, Quot.sound]
KC.StripeFront.stripe_prefix_family : ∀ (m : Nat) (b0 b1 b2 : Bool),
  ∃ d,
    1 ≤ d ∧
      d ≤ m + 5 ∧
        (∀ (k : Nat),
            1 ≤ k → k < d → KC.StripeFront.row3 m b0 b1 b2 k = Ruliology.CellularAutomata.Rule30ZeroBoundary.stripe k) ∧
          KC.StripeFront.row3 m b0 b1 b2 d ≠ Ruliology.CellularAutomata.Rule30ZeroBoundary.stripe d ∧
            ∃ t,
              t ≤ d - 1 + 31 ∧
                t % 2 = 0 ∧
                  Ruliology.CellularAutomata.Rule30ZeroBoundary.zrow (KC.StripeFront.row3 m b0 b1 b2) t 1 = false
