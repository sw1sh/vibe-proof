import Mathlib.Algebra.Field.ZMod
import Mathlib.Algebra.Polynomial.Degree.TrailingDegree
import Mathlib.Data.Fintype.BigOperators
import Mathlib.Data.Fintype.Pigeonhole
import Mathlib.RingTheory.PowerSeries.Inverse
import Mathlib.RingTheory.PowerSeries.Trunc
import Rule30Equivalents.Basic

/-!
# Problem 1 over `𝔽₂`: rational generating function, linear recurrences, linear complexity

Read a bit sequence `b : ℕ → Bool` as a sequence over the two-element field `𝔽₂ = ZMod 2`
(`true` = black = `1`) and form its generating function
`series b = ∑ₜ b(t) Xᵗ ∈ 𝔽₂⟦X⟧`.

## Statements

For every `b`, the following are equivalent (Lidl–Niederreiter, ch. 8, specialized to `𝔽₂`):

* `b` is eventually periodic;
* `series b` is **rational**: `Q · series b = P` for polynomials `P, Q ∈ 𝔽₂[X]` with `Q ≠ 0`
  (`eventuallyPeriodic_iff_rational`); equivalently with `Q(0) ≠ 0`
  (`eventuallyPeriodic_iff_rational_coeff_zero`), i.e. `series b = P · Q⁻¹` in `𝔽₂⟦X⟧`
  (`eventuallyPeriodic_iff_eq_mul_inv`);
* `b` satisfies an **eventual linear recurrence** over `𝔽₂`:
  `b(t + d) = ∑_{i < d} aᵢ · b(t + i)` for all `t ≥ T` (`eventuallyPeriodic_iff_linearRecurrence`);
  the recurrence can even be required from `t = 0`, i.e. `b` is the output of a linear feedback
  shift register (`eventuallyPeriodic_iff_linearRecurrence_from_zero`);
* the **linear complexity** of `b` is finite: one register length `d` serves every prefix
  `b 0, …, b (n - 1)` (`eventuallyPeriodic_iff_linearComplexity_bounded`).

Specialized to the center column `c`, Problem 1 says that the generating function of the center
column over `𝔽₂` is not rational (`problem1_iff_series_not_rational`,
`problem1_iff_series_not_rational_coeff_zero`, `problem1_iff_series_ne_mul_inv`), that the center
column satisfies no eventual linear recurrence over `𝔽₂`
(`problem1_iff_no_eventual_linear_recurrence`), that no linear feedback shift register generates
it (`problem1_iff_no_lfsr`), and that its linear complexity profile is unbounded
(`problem1_iff_linear_complexity_unbounded`). This is the function-field analogue of the
irrationality of the binary number `0.c(0)c(1)c(2)…₂`: `series c` is a formal power series that
should not lie in `𝔽₂(X)`.

## Proof idea

* Periodic ⇒ rational: if `b(t + p) = b(t)` for `t ≥ T`, the coefficients of `(1 - Xᵖ) · series b`
  vanish from degree `T + p` on, so that product is a polynomial `P`, and `Q = 1 - Xᵖ` has
  `Q(0) = 1` (`exists_mul_eq_of_eventuallyPeriodic`).
* Rational ⇒ recurrence: let `Q ≠ 0` have degree `D` and lowest exponent `k`; over `𝔽₂` its
  lowest coefficient is `1`. For `t > deg P`, the coefficient of `X^(t + D)` in `Q · series b = P`
  is `0`, which reads `b(t + D - k) = ∑_{m < D - k} Q_{D - m} · b(t + m)`
  (`linearRecurrence_of_mul_eq`).
* Recurrence ⇒ periodic: the window `(b t, …, b (t + d - 1))` ranges over the finite set
  `Fin d → Bool`, and from time `T` on the recurrence determines the next window from the current
  one. By pigeonhole two windows coincide, and from then on everything repeats
  (`eventuallyPeriodic_of_linearRecurrence`).
* Periodic ⇒ register from time `0`: `b(t + (T + p)) = b(t + T)` for all `t` is itself a linear
  recurrence of order `T + p` (`linearRecurrence_from_zero_of_eventuallyPeriodic`).
* Bounded linear complexity ⇒ register: there are only finitely many registers of length `d`, so
  if each prefix is generated by one of them, a single register generates every prefix.

## Sources

The equivalences are classical, over any finite field: R. Lidl and H. Niederreiter,
*Finite Fields*, 2nd ed., Encyclopedia of Mathematics and its Applications 20, Cambridge
University Press, 1997, Chapter 8 ("Linear Recurring Sequences"): linear recurring sequences are
ultimately periodic, and their generating functions are exactly the rational functions with
denominator nonzero at `0` (both in Chapter 8; see also Niederreiter's *Handbook of Finite
Fields*, Remark 10.4.3, which cites that chapter for the first fact). Linear
complexity: J. L. Massey, *Shift-register synthesis and BCH decoding*, IEEE Trans. Inform.
Theory 15 (1969) 122–127; R. A. Rueppel, *Analysis and Design of Stream Ciphers*, Springer, 1986.
Rule 30's center column as a keystream generator: S. Wolfram, *Cryptography with cellular
automata*, CRYPTO '85, LNCS 218 (1986) 429–432, and *Random sequence generation by cellular
automata*, Adv. Appl. Math. 7 (1986) 123–169.
-/

namespace Rule30Equivalents.PowerSeriesF2

open Ruliology.CellularAutomata
open Finset

/-- The bit `b t` as an element of `𝔽₂ = ZMod 2`. -/
def bit (b : ℕ → Bool) (t : ℕ) : ZMod 2 := if b t then 1 else 0

/-- The generating function `∑ₜ b(t) Xᵗ` of a bit sequence, as a power series over `𝔽₂`. -/
noncomputable def series (b : ℕ → Bool) : PowerSeries (ZMod 2) :=
  PowerSeries.mk (fun t => if b t then 1 else 0)

@[simp] theorem coeff_series (b : ℕ → Bool) (n : ℕ) :
    PowerSeries.coeff n (series b) = bit b n := by
  simp only [series, PowerSeries.coeff_mk, bit]

theorem bit_eq_bit_iff {b b' : ℕ → Bool} {t t' : ℕ} : bit b t = bit b' t' ↔ b t = b' t' := by
  unfold bit
  cases b t <;> cases b' t' <;> decide

/-- Coefficient `t + deg Q` of `Q · φ` for a polynomial `Q`. -/
theorem coeff_coe_mul_add_natDegree {R : Type*} [CommSemiring R] (Q : Polynomial R)
    (φ : PowerSeries R) (t : ℕ) :
    PowerSeries.coeff (t + Q.natDegree) ((Q : PowerSeries R) * φ) =
      ∑ m ∈ range (Q.natDegree + 1),
        Q.coeff (Q.natDegree - m) * PowerSeries.coeff (t + m) φ := by
  rw [PowerSeries.coeff_mul, Finset.Nat.sum_antidiagonal_eq_sum_range_succ
    (fun i j => PowerSeries.coeff i (Q : PowerSeries R) * PowerSeries.coeff j φ),
    show (t + Q.natDegree).succ = (Q.natDegree + 1) + t by omega, Finset.sum_range_add]
  have hz : ∑ x ∈ range t, PowerSeries.coeff (Q.natDegree + 1 + x) (Q : PowerSeries R) *
      PowerSeries.coeff (t + Q.natDegree - (Q.natDegree + 1 + x)) φ = 0 :=
    Finset.sum_eq_zero fun x _ => by
      rw [Polynomial.coeff_coe, Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), zero_mul]
  rw [hz, add_zero]
  refine Finset.sum_nbij' (fun m => Q.natDegree - m) (fun m => Q.natDegree - m) ?_ ?_ ?_ ?_ ?_
  · intro m hm; simp only [Finset.mem_range] at hm ⊢; omega
  · intro m hm; simp only [Finset.mem_range] at hm ⊢; omega
  · intro m hm; simp only [Finset.mem_range] at hm ⊢; omega
  · intro m hm; simp only [Finset.mem_range] at hm ⊢; omega
  · intro m hm
    simp only [Finset.mem_range] at hm
    rw [Polynomial.coeff_coe, show Q.natDegree - (Q.natDegree - m) = m by omega,
      show t + (Q.natDegree - m) = t + Q.natDegree - m by omega]

/-! ### Eventually periodic ⇒ linear recurrence ⇒ rational -/

/-- An eventually periodic sequence satisfies a linear recurrence over `𝔽₂` from time `0` on:
if `b (t + p) = b t` for `t ≥ T`, then `b (t + (T + p)) = b (t + T)` for every `t`. -/
theorem linearRecurrence_from_zero_of_eventuallyPeriodic {b : ℕ → Bool}
    (h : EventuallyPeriodic b) :
    ∃ (d : ℕ) (a : Fin d → ZMod 2), ∀ t, bit b (t + d) = ∑ i, a i * bit b (t + i) := by
  obtain ⟨T, p, hp, hper⟩ := h
  refine ⟨T + p, fun i => if (i : ℕ) = T then 1 else 0, fun t => ?_⟩
  rw [Finset.sum_eq_single (⟨T, by omega⟩ : Fin (T + p))]
  · simp only [if_true, one_mul]
    unfold bit
    rw [show t + (T + p) = t + T + p by omega, hper (t + T) (by omega)]
  · intro j _ hj
    have hjT : (j : ℕ) ≠ T := fun h => hj (Fin.ext h)
    simp only [hjT, if_false, zero_mul]
  · intro h
    exact absurd (Finset.mem_univ _) h

/-- An eventually periodic sequence has a rational generating function `P / Q` over `𝔽₂`, with
`Q = 1 - Xᵖ` for a period `p`; in particular `Q(0) ≠ 0`. -/
theorem exists_mul_eq_of_eventuallyPeriodic {b : ℕ → Bool} (h : EventuallyPeriodic b) :
    ∃ P Q : Polynomial (ZMod 2), Q.coeff 0 ≠ 0 ∧
      (Q : PowerSeries (ZMod 2)) * series b = (P : PowerSeries (ZMod 2)) := by
  obtain ⟨T, p, hp, hper⟩ := h
  refine ⟨PowerSeries.trunc (T + p)
    (((1 - Polynomial.X ^ p : Polynomial (ZMod 2)) : PowerSeries (ZMod 2)) * series b),
    1 - Polynomial.X ^ p, ?_, ?_⟩
  · rw [Polynomial.coeff_sub, Polynomial.coeff_one_zero, Polynomial.coeff_X_pow,
      if_neg (by omega), sub_zero]
    exact one_ne_zero
  · refine PowerSeries.ext fun n => ?_
    rw [Polynomial.coeff_coe, PowerSeries.coeff_trunc]
    split_ifs with hn
    · rfl
    · rw [Polynomial.coe_sub, Polynomial.coe_one, Polynomial.coe_pow, Polynomial.coe_X, sub_mul,
        one_mul, map_sub, PowerSeries.coeff_X_pow_mul', if_pos (by omega), coeff_series,
        coeff_series]
      have hn' := hper (n - p) (by omega)
      rw [Nat.sub_add_cancel (by omega)] at hn'
      unfold bit
      rw [hn', sub_self]

/-! ### Rational ⇒ linear recurrence -/

/-- If `Q · series b = P` with `Q ≠ 0`, then `b` satisfies an eventual linear recurrence over
`𝔽₂` of order `deg Q - ord Q`. Its coefficients are read off from `Q`, normalized by the lowest
nonzero coefficient of `Q` (which is `1` over `𝔽₂`). -/
theorem linearRecurrence_of_mul_eq {b : ℕ → Bool} {P Q : Polynomial (ZMod 2)} (hQ : Q ≠ 0)
    (h : (Q : PowerSeries (ZMod 2)) * series b = (P : PowerSeries (ZMod 2))) :
    ∃ (d : ℕ) (a : Fin d → ZMod 2) (T : ℕ),
      ∀ t, T ≤ t → bit b (t + d) = ∑ i, a i * bit b (t + i) := by
  have hkD : Q.natTrailingDegree ≤ Q.natDegree := Polynomial.natTrailingDegree_le_natDegree Q
  have hlow : Q.coeff Q.natTrailingDegree = 1 := by
    have h1 : Q.trailingCoeff ≠ 0 := Polynomial.trailingCoeff_nonzero_iff_nonzero.mpr hQ
    have h2 : ∀ x : ZMod 2, x ≠ 0 → x = 1 := by decide
    exact h2 _ h1
  refine ⟨Q.natDegree - Q.natTrailingDegree, fun i => Q.coeff (Q.natDegree - i),
    P.natDegree + 1, fun t ht => ?_⟩
  have h0 : PowerSeries.coeff (t + Q.natDegree)
      ((Q : PowerSeries (ZMod 2)) * series b) = 0 := by
    rw [h, Polynomial.coeff_coe]
    exact Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
  rw [coeff_coe_mul_add_natDegree, show Q.natDegree + 1 =
      (Q.natDegree - Q.natTrailingDegree + 1) + Q.natTrailingDegree by omega,
    Finset.sum_range_add, Finset.sum_range_succ] at h0
  have hz : ∑ m ∈ range Q.natTrailingDegree,
      Q.coeff (Q.natDegree - (Q.natDegree - Q.natTrailingDegree + 1 + m)) *
        PowerSeries.coeff (t + (Q.natDegree - Q.natTrailingDegree + 1 + m)) (series b) = 0 :=
    Finset.sum_eq_zero fun m hm => by
      rw [Finset.mem_range] at hm
      rw [Polynomial.coeff_eq_zero_of_lt_natTrailingDegree (by omega), zero_mul]
  rw [hz, add_zero, show Q.natDegree - (Q.natDegree - Q.natTrailingDegree) =
      Q.natTrailingDegree by omega, hlow, one_mul] at h0
  simp only [coeff_series] at h0
  rw [Fin.sum_univ_eq_sum_range (fun i => Q.coeff (Q.natDegree - i) * bit b (t + i))]
  exact (eq_neg_iff_add_eq_zero.mpr (by rw [add_comm]; exact h0)).trans
    (ZMod.neg_eq_self_mod_two _)

/-! ### Linear recurrence ⇒ eventually periodic -/

/-- The window argument: if `b` satisfies an order-`d` recurrence from time `T` on and the
windows `b t₁, …, b (t₁ + d - 1)` and `b t₂, …, b (t₂ + d - 1)` agree for some `T ≤ t₁ < t₂`,
then `b` is eventually periodic with period `t₂ - t₁`. -/
theorem eventuallyPeriodic_of_window_eq {b : ℕ → Bool} {d : ℕ} {a : Fin d → ZMod 2} {T : ℕ}
    (h : ∀ t, T ≤ t → bit b (t + d) = ∑ i, a i * bit b (t + i)) {t₁ t₂ : ℕ}
    (h₁ : T ≤ t₁) (h₁₂ : t₁ < t₂) (h0 : ∀ i < d, b (t₁ + i) = b (t₂ + i)) :
    EventuallyPeriodic b := by
  have step : ∀ n, (∀ i < d, b (t₁ + n + i) = b (t₂ + n + i)) →
      b (t₁ + n + d) = b (t₂ + n + d) := by
    intro n hn
    rw [← bit_eq_bit_iff, h _ (by omega), h _ (by omega)]
    refine Finset.sum_congr rfl fun j _ => ?_
    unfold bit
    rw [hn j j.isLt]
  have all : ∀ n, ∀ i < d, b (t₁ + n + i) = b (t₂ + n + i) := by
    intro n
    induction n with
    | zero => simpa using h0
    | succ n ih =>
      intro i hi
      rcases Nat.lt_or_ge (i + 1) d with h' | h'
      · have := ih (i + 1) h'
        rwa [show t₁ + (n + 1) + i = t₁ + n + (i + 1) by omega,
          show t₂ + (n + 1) + i = t₂ + n + (i + 1) by omega]
      · have := step n ih
        rwa [show t₁ + (n + 1) + i = t₁ + n + d by omega,
          show t₂ + (n + 1) + i = t₂ + n + d by omega]
  refine ⟨t₁ + d, t₂ - t₁, by omega, fun t ht => ?_⟩
  have := step (t - (t₁ + d)) (all _)
  rw [show t₁ + (t - (t₁ + d)) + d = t by omega,
    show t₂ + (t - (t₁ + d)) + d = t + (t₂ - t₁) by omega] at this
  exact this.symm

/-- A sequence satisfying an eventual linear recurrence over `𝔽₂` is eventually periodic: the
window of the last `d` bits moves through the finite set `Fin d → Bool`, so two windows repeat
(pigeonhole), and from then on the recurrence repeats everything. -/
theorem eventuallyPeriodic_of_linearRecurrence {b : ℕ → Bool} {d : ℕ} {a : Fin d → ZMod 2}
    {T : ℕ} (h : ∀ t, T ≤ t → bit b (t + d) = ∑ i, a i * bit b (t + i)) :
    EventuallyPeriodic b := by
  obtain ⟨x, y, hxy, hw⟩ :=
    Finite.exists_ne_map_eq_of_infinite (fun n : ℕ => fun i : Fin d => b (T + n + i))
  rcases Nat.lt_or_gt_of_ne hxy with hlt | hlt
  · exact eventuallyPeriodic_of_window_eq h (t₁ := T + x) (t₂ := T + y) (by omega) (by omega)
      fun i hi => congrFun hw ⟨i, hi⟩
  · exact eventuallyPeriodic_of_window_eq h (t₁ := T + y) (t₂ := T + x) (by omega) (by omega)
      fun i hi => (congrFun hw ⟨i, hi⟩).symm

/-! ### The equivalences for an arbitrary bit sequence -/

/-- **Rational generating function.** A bit sequence is eventually periodic iff its generating
function over `𝔽₂` is rational: `Q · ∑ₜ b(t) Xᵗ = P` for polynomials `P, Q` with `Q ≠ 0`. -/
theorem eventuallyPeriodic_iff_rational (b : ℕ → Bool) :
    EventuallyPeriodic b ↔ ∃ P Q : Polynomial (ZMod 2), Q ≠ 0 ∧
      (Q : PowerSeries (ZMod 2)) * series b = (P : PowerSeries (ZMod 2)) := by
  constructor
  · intro h
    obtain ⟨P, Q, hQ, hPQ⟩ := exists_mul_eq_of_eventuallyPeriodic h
    exact ⟨P, Q, fun h0 => hQ (by rw [h0, Polynomial.coeff_zero]), hPQ⟩
  · rintro ⟨P, Q, hQ, hPQ⟩
    obtain ⟨d, a, T, h⟩ := linearRecurrence_of_mul_eq hQ hPQ
    exact eventuallyPeriodic_of_linearRecurrence h

/-- **Rational generating function, invertible denominator.** The same with `Q(0) ≠ 0`, so
that `Q` is a unit of `𝔽₂⟦X⟧` and `series b = P · Q⁻¹`. -/
theorem eventuallyPeriodic_iff_rational_coeff_zero (b : ℕ → Bool) :
    EventuallyPeriodic b ↔ ∃ P Q : Polynomial (ZMod 2), Q.coeff 0 ≠ 0 ∧
      (Q : PowerSeries (ZMod 2)) * series b = (P : PowerSeries (ZMod 2)) := by
  constructor
  · exact exists_mul_eq_of_eventuallyPeriodic
  · rintro ⟨P, Q, hQ, hPQ⟩
    exact (eventuallyPeriodic_iff_rational b).2
      ⟨P, Q, fun h0 => hQ (by rw [h0, Polynomial.coeff_zero]), hPQ⟩

/-- **`series b = P / Q`.** A bit sequence is eventually periodic iff its generating function is
a quotient `P · Q⁻¹` of polynomials in `𝔽₂⟦X⟧` with `Q(0) ≠ 0` (so that `Q` is a unit). -/
theorem eventuallyPeriodic_iff_eq_mul_inv (b : ℕ → Bool) :
    EventuallyPeriodic b ↔ ∃ P Q : Polynomial (ZMod 2), Q.coeff 0 ≠ 0 ∧
      series b = (P : PowerSeries (ZMod 2)) * (Q : PowerSeries (ZMod 2))⁻¹ := by
  rw [eventuallyPeriodic_iff_rational_coeff_zero]
  refine exists₂_congr fun P Q => and_congr_right fun hQ => ?_
  rw [PowerSeries.eq_mul_inv_iff_mul_eq (by rwa [Polynomial.constantCoeff_coe]), mul_comm]

/-- **Eventual linear recurrence over `𝔽₂`.** A bit sequence is eventually periodic iff from some
time `T` on it satisfies a linear recurrence `b(t + d) = ∑_{i < d} aᵢ · b(t + i)` over `𝔽₂`. -/
theorem eventuallyPeriodic_iff_linearRecurrence (b : ℕ → Bool) :
    EventuallyPeriodic b ↔ ∃ (d : ℕ) (a : Fin d → ZMod 2) (T : ℕ), ∀ t, T ≤ t →
      ((if b (t + d) then 1 else 0 : ZMod 2)) = ∑ i, a i * (if b (t + i) then 1 else 0) := by
  constructor
  · intro h
    obtain ⟨d, a, ha⟩ := linearRecurrence_from_zero_of_eventuallyPeriodic h
    exact ⟨d, a, 0, fun t _ => ha t⟩
  · rintro ⟨d, a, T, h⟩
    exact eventuallyPeriodic_of_linearRecurrence (a := a) (T := T) h

/-- **Linear feedback shift register.** The recurrence can be required to hold from `t = 0`:
a bit sequence is eventually periodic iff it is the output of some linear feedback shift
register over `𝔽₂` (whose feedback may be singular, `a 0 = 0`). -/
theorem eventuallyPeriodic_iff_linearRecurrence_from_zero (b : ℕ → Bool) :
    EventuallyPeriodic b ↔ ∃ (d : ℕ) (a : Fin d → ZMod 2), ∀ t,
      ((if b (t + d) then 1 else 0 : ZMod 2)) = ∑ i, a i * (if b (t + i) then 1 else 0) := by
  constructor
  · exact linearRecurrence_from_zero_of_eventuallyPeriodic
  · rintro ⟨d, a, h⟩
    exact eventuallyPeriodic_of_linearRecurrence (a := a) (T := 0) fun t _ => h t

/-- **Bounded linear complexity profile.** A bit sequence is eventually periodic iff there is one
length `d` such that every prefix `b 0, …, b (n - 1)` is generated by a linear feedback shift
register of length `d` over `𝔽₂` (the register may depend on `n`). In other words the linear
complexity of the prefixes of `b` stays bounded. -/
theorem eventuallyPeriodic_iff_linearComplexity_bounded (b : ℕ → Bool) :
    EventuallyPeriodic b ↔ ∃ d : ℕ, ∀ n : ℕ, ∃ a : Fin d → ZMod 2, ∀ t, t + d < n →
      ((if b (t + d) then 1 else 0 : ZMod 2)) = ∑ i, a i * (if b (t + i) then 1 else 0) := by
  constructor
  · intro h
    obtain ⟨d, a, ha⟩ := linearRecurrence_from_zero_of_eventuallyPeriodic h
    exact ⟨d, fun _ => ⟨a, fun t _ => ha t⟩⟩
  · rintro ⟨d, hd⟩
    -- Only finitely many registers of length `d` exist, so one of them generates every prefix.
    have : ∃ a : Fin d → ZMod 2, ∀ t, bit b (t + d) = ∑ i, a i * bit b (t + i) := by
      by_contra hne
      simp only [not_exists, not_forall] at hne
      choose tbad htbad using hne
      obtain ⟨a, ha⟩ := hd (Finset.univ.sup tbad + d + 1)
      exact htbad a (ha (tbad a) (by
        have := Finset.le_sup (f := tbad) (Finset.mem_univ a)
        omega))
    obtain ⟨a, ha⟩ := this
    exact eventuallyPeriodic_of_linearRecurrence (a := a) (T := 0) fun t _ => ha t

/-! ### Problem 1 -/

/-- **Problem 1 ⇔ the generating function of the center column over `𝔽₂` is not rational.** -/
theorem problem1_iff_series_not_rational : Rule30Prize.Problem1 ↔
    ¬ ∃ P Q : Polynomial (ZMod 2), Q ≠ 0 ∧
      (Q : PowerSeries (ZMod 2)) * series c = (P : PowerSeries (ZMod 2)) :=
  problem1_iff_not_eventuallyPeriodic.trans (not_congr (eventuallyPeriodic_iff_rational c))

/-- Problem 1 ⇔ the generating function of the center column is not of the form `P / Q` with
`Q(0) ≠ 0`. -/
theorem problem1_iff_series_not_rational_coeff_zero : Rule30Prize.Problem1 ↔
    ¬ ∃ P Q : Polynomial (ZMod 2), Q.coeff 0 ≠ 0 ∧
      (Q : PowerSeries (ZMod 2)) * series c = (P : PowerSeries (ZMod 2)) :=
  problem1_iff_not_eventuallyPeriodic.trans
    (not_congr (eventuallyPeriodic_iff_rational_coeff_zero c))

/-- Problem 1 ⇔ the generating function of the center column is not a quotient `P · Q⁻¹` of
polynomials over `𝔽₂` (with `Q(0) ≠ 0`). -/
theorem problem1_iff_series_ne_mul_inv : Rule30Prize.Problem1 ↔
    ¬ ∃ P Q : Polynomial (ZMod 2), Q.coeff 0 ≠ 0 ∧
      series c = (P : PowerSeries (ZMod 2)) * (Q : PowerSeries (ZMod 2))⁻¹ :=
  problem1_iff_not_eventuallyPeriodic.trans (not_congr (eventuallyPeriodic_iff_eq_mul_inv c))

/-- **Problem 1 ⇔ the center column satisfies no eventual linear recurrence over `𝔽₂`.** -/
theorem problem1_iff_no_eventual_linear_recurrence : Rule30Prize.Problem1 ↔
    ¬ ∃ (d : ℕ) (a : Fin d → ZMod 2) (T : ℕ), ∀ t, T ≤ t →
      ((if c (t + d) then 1 else 0 : ZMod 2)) = ∑ i, a i * (if c (t + i) then 1 else 0) :=
  problem1_iff_not_eventuallyPeriodic.trans
    (not_congr (eventuallyPeriodic_iff_linearRecurrence c))

/-- Problem 1 ⇔ no linear feedback shift register over `𝔽₂`, of any length `d`, generates the
center column: its linear complexity is infinite. -/
theorem problem1_iff_no_lfsr : Rule30Prize.Problem1 ↔
    ∀ d : ℕ, ¬ ∃ a : Fin d → ZMod 2, ∀ t,
      ((if c (t + d) then 1 else 0 : ZMod 2)) = ∑ i, a i * (if c (t + i) then 1 else 0) :=
  problem1_iff_not_eventuallyPeriodic.trans
    ((not_congr (eventuallyPeriodic_iff_linearRecurrence_from_zero c)).trans not_exists)

/-- **Problem 1 ⇔ the linear complexity profile of the center column is unbounded**: for every
`d` some prefix `c 0, …, c (n - 1)` is generated by no linear feedback shift register of
length `d` over `𝔽₂`. -/
theorem problem1_iff_linear_complexity_unbounded : Rule30Prize.Problem1 ↔
    ∀ d : ℕ, ∃ n : ℕ, ¬ ∃ a : Fin d → ZMod 2, ∀ t, t + d < n →
      ((if c (t + d) then 1 else 0 : ZMod 2)) = ∑ i, a i * (if c (t + i) then 1 else 0) :=
  problem1_iff_not_eventuallyPeriodic.trans
    ((not_congr (eventuallyPeriodic_iff_linearComplexity_bounded c)).trans
      (not_exists.trans (forall_congr' fun _ => not_forall)))

end Rule30Equivalents.PowerSeriesF2
